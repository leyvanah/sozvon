*~
/galene
/sozvon
/sozvon.exe
/sozvon-smoke.exe
/sozvon-test.exe
/sozvon.log
# The pre-rename names.  Local build output and working files still carry
# them, and an entry that only matches the new name silently stops ignoring
# a file that already exists on disk.
/oryn
/oryn.exe
/oryn-smoke.exe
/oryn-test.exe
/oryn.log
/galenectl/galenectl
/data
/recordings
/groups/**/*.json
/static/**/*.d.ts
/static/third-party/tasks-vision

# Local artefacts
/logs/
/sozvon-rebrand.tar.gz
/oryn-rebrand.tar.gz

# Claude Code local context (machine-specific, never commit)
CLAUDE.local.md
/.claude/

# Claude Code project file - local only, not for the repo
CLAUDE.md

# Local-only test-stand doc — holds the LAN hostname, never commit (see CLAUDE.local.md)
/sozvon-test-stand.md
/oryn-test-stand.md

# Local-only manual test protocols — the procedures run by hand before a
# deploy.  TESTING.md is the public half; this is the working document.
/TEST-PROTOCOLS.local.md

# Browser tests: the specs are tracked, their dependencies and run output are
# not.
/test/browser/node_modules/
/test/browser/test-results/

# Local-only remote-device testing notes — hold a LAN address and device
# details for the test phone, never commit
/android/REMOTE-TESTING.md

# Local-only known-bugs log — internal debugging notes, not for the public repo
/KNOWN-BUGS.md

# JetBrains IDE project files — machine-local paths/names, never commit
/.idea/

# Release build output (contrib/install.sh + .github/workflows/release.yml)
/build/
/dist/

# Local-only pre-publication checklist — process notes, not part of the project
/PRE-PUBLISH.md

# Generated before each Android build from contrib/install.sh (see
# android/app/build.gradle.kts); a tracked copy would drift.
/android/app/src/main/assets/install.sh

# Server release fetched before each Android build (see
# android/app/build.gradle.kts, task fetchServerRelease); 17 MB of binaries
# per release do not belong in the history.
/android/app/src/main/assets/server/

# Signing keys never belong in the repository, not even the "harmless" ones:
# a committed key is a key anybody can sign a look-alike update with.  The
# release keystore and the properties naming it live outside the checkout;
# see android/README.md.
*.jks
*.keystore
*.p12
/android/keystore.properties

# Shared working context, synced between machines outside git (a junction into
# a sync folder).  Session notes and decision logs -- working material, not
# project documentation, and the repository is public.
/context/
