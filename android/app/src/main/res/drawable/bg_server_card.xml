<?xml version="1.0" encoding="utf-8"?>
<!-- The card behind a saved server: the web client's surface colour with a
     hairline border, so the list reads as rows rather than floating text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sozvon_surface"/>
    <stroke
        android:width="1dp"
        android:color="@color/sozvon_border"/>
    <corners android:radius="10dp"/>
</shape>
