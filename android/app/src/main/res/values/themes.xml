<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: the page is the UI.  DayNight, like the web client,
         whose default is likewise to follow the system — and when the user
         overrides that in the client's settings, Theming.kt passes the choice
         on, so the app's own chrome does not stay dark behind a light client.

         Every colour below resolves through values/colors.xml or
         values-night/colors.xml, so this one style serves both themes.  The
         light status- and navigation-bar flags are *not* set here: they need
         to change with the mode, and doing it from code covers both bars
         across API levels without a second and third values bucket. -->
    <style name="Theme.Sozvon" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/sozvon_bg</item>
        <item name="colorPrimary">@color/sozvon_accent</item>
        <item name="colorPrimaryDark">@color/sozvon_bg</item>
        <item name="colorAccent">@color/sozvon_accent</item>
        <item name="android:statusBarColor">@color/sozvon_bg</item>
        <item name="android:navigationBarColor">@color/sozvon_bg</item>
        <item name="android:colorEdgeEffect">@color/sozvon_accent</item>
    </style>

    <!-- Field furniture for the deploy screen, so the layout stays readable
         instead of repeating the same eight attributes per input. -->
    <style name="SozvonFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/sozvon_text2</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SozvonField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:backgroundTint">@color/sozvon_accent</item>
        <item name="android:textColor">@color/sozvon_text</item>
        <item name="android:textColorHint">@color/sozvon_text3</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SozvonHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/sozvon_text3</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SozvonValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/sozvon_text</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
