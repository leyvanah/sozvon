<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the launcher icon -> "Change server": reopens the server
     address screen (MainActivity handles the extra). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="change_server"
        android:enabled="true"
        android:icon="@drawable/ic_sozvon"
        android:shortcutShortLabel="@string/change_server">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="org.sozvon.app"
            android:targetClass="org.sozvon.app.MainActivity">
            <extra
                android:name="org.sozvon.app.CHANGE_SERVER"
                android:value="true"/>
        </intent>
    </shortcut>
</shortcuts>
